# ---- cp: файл -> новый файл, файл -> папка, перезапись, -r ----
cp readme.txt copy.txt
ls
cp readme.txt docs
ls docs
cp readme.txt docs/todo.txt
tail docs/todo.txt
cp -r docs docs_backup
cp -r docs/archive empty_dir
cp readme.txt copy.txt empty_dir
vfs-tree
# ---- mv: переименование, в папку, несколько источников, папка ----
mv copy.txt renamed.txt
mv renamed.txt docs/archive
ls docs/archive
mv docs_backup backup
mv .hidden empty_dir/readme.txt backup
cd backup
ls -a
cd /
mv backup docs/archive/2024
vfs-tree
# ---- исходник при cp остаётся, при mv исчезает ----
ls
du -h
